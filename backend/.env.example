CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_SCHOOL_EMAIL_DOMAINS=stu.cu.edu.ng,covenantuniversity.edu.ng
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://alms_user:alms_password@localhost:5432/alms_db

# Keyless Firebase/Google token verification. The API fetches public signing
# certificates and never needs a Firebase service-account private key.
FIREBASE_PROJECT_ID=exammind-509123
GOOGLE_OAUTH_CLIENT_ID=replace-with-the-Firebase-Web-OAuth-client-id
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLOCK_SKEW_SECONDS=60
FIREBASE_CERT_FETCH_TIMEOUT_SECONDS=10
ACCOUNT_DELETION_ENABLED=false
PERMANENT_ACCOUNT_DELETION_ENABLED=false
FIREBASE_ADMIN_DELETE_ENABLED=false

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
APP_ENV=development
ENV=development
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
AI_FALLBACK_PROVIDER=cohere
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024
# Optional audio transcription. whisper-1 remains the supported OpenAI model.
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
TRANSCRIPTION_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=10485760
MAX_INDEX_CHUNKS=40
MAX_RAG_QUESTION_CHARS=2000
# Distributed PostgreSQL-backed limits. Set RATE_LIMIT_ENABLED=false only for
# isolated local development; the application never falls back to process memory.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAILURE_MODE=closed
RATE_LIMIT_AUTH_SESSION_LIMIT=10
RATE_LIMIT_AUTH_SESSION_WINDOW_SECONDS=900
RATE_LIMIT_KSA_VERIFY_LIMIT=5
RATE_LIMIT_KSA_VERIFY_WINDOW_SECONDS=900
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_MAXE_LIMIT=30
RATE_LIMIT_MAXE_WINDOW_SECONDS=60
RATE_LIMIT_SESSION_AI_LIMIT=20
RATE_LIMIT_SESSION_AI_WINDOW_SECONDS=60
RATE_LIMIT_QUIZ_GENERATE_LIMIT=10
RATE_LIMIT_QUIZ_GENERATE_WINDOW_SECONDS=900
RATE_LIMIT_SHARE_CREATE_LIMIT=20
RATE_LIMIT_SHARE_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_DOWNLOAD_LIMIT=60
RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_EXPORT_LIMIT=30
RATE_LIMIT_EXPORT_WINDOW_SECONDS=3600
RATE_LIMIT_SHARE_READ_LIMIT=120
RATE_LIMIT_SHARE_READ_WINDOW_SECONDS=900
RATE_LIMIT_PUBLIC_FEEDBACK_LIMIT=5
RATE_LIMIT_PUBLIC_FEEDBACK_WINDOW_SECONDS=900
SQL_ECHO=false
