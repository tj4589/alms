CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_SCHOOL_EMAIL_DOMAINS=stu.cu.edu.ng,covenantuniversity.edu.ng
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://alms_user:alms_password@localhost:5432/alms_db

# Keyless Firebase/Google token verification. The API fetches public signing
# certificates and never needs a Firebase service-account private key.
FIREBASE_PROJECT_ID=exammind-509123
GOOGLE_OAUTH_CLIENT_ID=replace-with-the-Firebase-Web-OAuth-client-id
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
FIREBASE_CLOCK_SKEW_SECONDS=60
FIREBASE_CERT_FETCH_TIMEOUT_SECONDS=10

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
AI_FALLBACK_PROVIDER=cohere
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024
MAX_UPLOAD_BYTES=10485760
MAX_INDEX_CHUNKS=40
MAX_RAG_QUESTION_CHARS=2000
SQL_ECHO=false
